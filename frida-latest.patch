-    else
-      s->__bcr[n] = 0;
-  }
-  else
-  {
-    arm_debug_state_t * s = state;
-    uint32_t bas = (break_at & 1) ? FRIDA_BAS_THUMB : FRIDA_BAS_ANY;
-
-    s->__bvr[n] = break_at;
-    if (break_at != 0)
-      s->__bcr[n] = (bas << 5) | FRIDA_S_USER | FRIDA_BCR_ENABLE;
