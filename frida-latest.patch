-  if (in_fd != NULL)
-    posix_spawn_file_actions_adddup2 (&file_actions, in_fd->handle, 0);
-  if (out_fd != NULL)
-    posix_spawn_file_actions_adddup2 (&file_actions, out_fd->handle, 1);
-  if (err_fd != NULL)
