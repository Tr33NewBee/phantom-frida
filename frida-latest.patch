-  posix_spawnattr_setsigmask (&attributes, &signal_mask_set);
-
-  flags = POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_START_SUSPENDED;
