-    services = (ENUM_SERVICE_STATUS_PROCESSW *) services_data;
-    for (i = 0; i != num_services; i++)
-    {
-      ENUM_SERVICE_STATUS_PROCESSW * service = &services[i];
-
-      if (wcsncmp (service->lpServiceName, L"frida-", 6) == 0 && wcslen (service->lpServiceName) == 41)
