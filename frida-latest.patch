-static csh
-frida_create_capstone (GumCpuType cpu_type, GumAddress start)
-{
-  csh capstone;
-  cs_err err;
-
-  switch (cpu_type)
-  {
-#ifdef HAVE_I386
-    case GUM_CPU_IA32:
-      cs_arch_register_x86 ();
