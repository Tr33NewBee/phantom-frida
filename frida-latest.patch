-next_phase:
-  switch (self->breakpoint_phase)
-  {
-    case FRIDA_BREAKPOINT_SET_LIBDYLD_INITIALIZE_CALLER_BREAKPOINT:
-    {
-      GumAddress frame_pointer = 0;
-      guint64 * ret_addr_data;
-      GumAddress libsystem_initializer_caller;
