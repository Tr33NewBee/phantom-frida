-      return TRUE;
-
-    case FRIDA_BREAKPOINT_DLOPEN_BOOTSTRAPPER:
-#if defined (HAVE_IOS) || defined (HAVE_TVOS) || defined (HAVE_XROS)
-      if (self->bootstrapper_name != 0)
-      {
-        frida_spawn_instance_set_libc_initialized (self);
